MONGODB_URI=mongodb+srv://username:password@cluster.example.net/GatePyqs
MONGODB_URI_2=mongodb+srv://username:password@cluster.example.net/scrapedPyqs

# Required in production. Use a long, unique random value for each.
JWT_SECRET=replace-with-a-long-random-secret
APP_PASSWORD=replace-with-a-long-unique-application-password

